      "imports": [
        "json",
        "re"
      ],
      "code": "def parse_rg_json(stdout: str, query: str) -> list[Evidence]:\n    out: list[Evidence] = []\n    for line in stdout.splitlines():\n        try:\n            ev = json.loads(line)\n        except ValueError:\n            continue\n        if ev.get(\"type\") != \"match\":\n            continue\n        d = ev[\"data\"]\n        path = d.get(\"path\", {}).get(\"text\")\n        n = d.get(\"line_number\")\n        if path is None or n is None:\n            continue\n        path = path.removeprefix(\"./\")\n        out.append(Evidence(path=path, start=n, end=n, source=\"ripgrep\",\n                            role=role_for_path(path), query=query))\n    return out"
    },
